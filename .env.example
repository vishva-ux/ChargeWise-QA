# ==============================================================================
# ChargeWise QA Automation - Environment Configuration Template
# Copy this file to .env and customize values according to your environment
# ==============================================================================

# Target Application URLs (System Under Test)
CHARGEWISE_BASE_URL=http://localhost:3000
CHARGEWISE_API_URL=http://localhost:8080/api/v1
CHARGEWISE_ML_URL=http://localhost:8000

# Browser & UI Automation Settings
SELENIUM_BROWSER=chrome
SELENIUM_HEADLESS=true
SELENIUM_IMPLICIT_WAIT=10
SELENIUM_PAGE_LOAD_TIMEOUT=30
SELENIUM_WINDOW_WIDTH=1920
SELENIUM_WINDOW_HEIGHT=1080

# Test Credentials
TEST_USER_USERNAME=user
TEST_USER_PASSWORD=user
TEST_USER_PHONE=+91 98765 43210
TEST_ADMIN_USERNAME=admin
TEST_ADMIN_PASSWORD=admin123

# Database Connection (PostgreSQL / PostGIS)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chargewise_db
DB_USER=postgres
DB_PASSWORD=postgrespassword
DB_SSL_MODE=prefer

# Redis Connection (Optional Direct Validation)
REDIS_HOST=localhost
REDIS_PORT=6379

# Reporting & Execution Control
ALLURE_RESULTS_DIR=reports/allure-results
SCREENSHOT_DIR=reports/screenshots
LOG_LEVEL=INFO
